{
  "info": {
    "name": "Week 12 - Laravel Student REST API",
    "description": "Web Development 2 (Laravel). Teaching exercise covering REST, CRUD resource routes, JSON, status codes, validation, and Postman. Use dummy records. Replace the base_url variable with your live Codespaces forwarded HTTPS URL when testing from the Postman cloud agent. Do not expose sensitive data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "student_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 - Health check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Returns a JSON status message."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Get all students",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/students",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "students"
          ]
        },
        "description": "GET returns seeded students as a JSON array."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Get one student",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/students/{{student_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "students",
            "{{student_id}}"
          ]
        },
        "description": ""
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Create student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/students",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "students"
          ]
        },
        "description": "Saves new student and stores its ID in student_id for the next requests.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Pedro Reyes\",\n  \"course\": \"BSIT\",\n  \"year_level\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set(\"student_id\", String(pm.response.json().id));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Update student",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/students/{{student_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "students",
            "{{student_id}}"
          ]
        },
        "description": "PATCH updates only the course field.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"course\": \"BSCS\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Delete student",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/students/{{student_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "students",
            "{{student_id}}"
          ]
        },
        "description": "DELETE returns 204 No Content."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"204 No Content\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Validation error",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/students",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "students"
          ]
        },
        "description": "Demonstrates JSON validation errors.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"course\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"422 Unprocessable Content\", function () { pm.response.to.have.status(422); });"
            ]
          }
        }
      ]
    }
  ]
}
